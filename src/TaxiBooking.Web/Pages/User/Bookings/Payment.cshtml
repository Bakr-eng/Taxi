@page "{id:int}"
@model TaxiBooking.Web.Pages.User.Bookings.PaymentModel
@{
    ViewData["Title"] = "Betala bokning";
}

<h1>Betala din bokning</h1>

@if (Model.Booking != null)
{
    var b = Model.Booking;
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 text-muted">Din resa</h2>
            <div class="fw-bold mb-1">@b.PickupAddress &rarr; @b.DropoffAddress</div>
            <div class="text-muted small mb-3">Upphämtning: @b.PickupTime.ToString("g")</div>

            <div class="price-estimate-box d-inline-block mb-4">
                <table class="price-breakdown mb-0">
                    <tr class="price-total"><td>Totalt att betala</td><td class="text-end">@b.EstimatedFare.ToString("0.00") kr</td></tr>
                </table>
            </div>

            <h2 class="h6 text-muted">Välj betalsätt</h2>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <form method="post" asp-route-id="@b.Id">
                        <input type="hidden" name="method" value="Swish" />
                        <button type="submit" class="btn btn-outline-primary w-100 py-3">
                            <div class="fs-4 mb-1">📱</div>
                            Swish
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                    <form method="post" asp-route-id="@b.Id">
                        <input type="hidden" name="method" value="Kort" />
                        <button type="submit" class="btn btn-outline-primary w-100 py-3">
                            <div class="fs-4 mb-1">💳</div>
                            Kort
                        </button>
                    </form>
                </div>
                <div class="col-md-4">
                    <form method="post" asp-route-id="@b.Id">
                        <input type="hidden" name="method" value="Later" />
                        <button type="submit" class="btn btn-outline-secondary w-100 py-3">
                            <div class="fs-4 mb-1">🕒</div>
                            Betala senare
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
